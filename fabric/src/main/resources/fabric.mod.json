{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "contact": {
    "homepage": "https://modrinth.com/mod/${mod_slug}",
    "sources": "${mod_sources}"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["com.nanobuntv.cartridge.fabric.CartridgeFabric"],
    "client": ["com.nanobuntv.cartridge.fabric.CartridgeFabricClient"],
    "modmenu": ["com.nanobuntv.cartridge.fabric.ModMenuEntry"]
  },
  "mixins": ["${mod_id}.mixins.json", "${mod_id}.controlify.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "${yacl_id}": ">=${yacl_range}",
    "minecraft": "${mc_compat_fabric}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
