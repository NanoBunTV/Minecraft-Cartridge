{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "contact": {
    "homepage": "https://modrinth.com/mod/${mod_slug}",
    "sources": "${mod_sources}"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["com.nanobuntv.cartridge.arcade.fabric.CartridgeArcadeFabric"],
    "client": ["com.nanobuntv.cartridge.arcade.fabric.CartridgeArcadeFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "cartridge_mod": "~${cartridge_version}",
    "minecraft": "${mc_compat_fabric}",
    "java": ">=${java_version}"
  }
}
