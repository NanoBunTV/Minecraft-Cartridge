# Auto detect text files and perform LF normalization
* text=auto

# Wrapper scripts must keep their native line endings
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
# cartridge-host, built from sidecar/ and downloaded by the mod from this repository (D218): byte for byte
natives/** binary

# D195: MAME for Cartridge: Arcade is over GitHub's 100 MB file limit
arcade/cores/mame/*.zip filter=lfs diff=lfs merge=lfs -text
